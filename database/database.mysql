USE ecotrack2026_db;

SET time_zone = '-05:00';

-- 4. TABLA SOLICITUD
CREATE TABLE IF NOT EXISTS tb_solicitud (
    id_solicitud INT AUTO_INCREMENT PRIMARY KEY,
    fecha_registro DATETIME(6) NOT NULL,
    titulo VARCHAR(255) NOT NULL,
    descripcion TEXT NOT NULL,
    ubicacion VARCHAR(255) NOT NULL,
    fecha_finalizacion DATETIME(6),
    id_usuario INT NOT NULL,
    estado VARCHAR(255) NOT NULL,

    CONSTRAINT fk_solicitud_usuario
        FOREIGN KEY (id_usuario)
        REFERENCES tb_usuario(id_usuario)
);

-- 5. TABLA RECOMENDACION
CREATE TABLE IF NOT EXISTS tb_recomendacion (
    id_recomendacion INT AUTO_INCREMENT PRIMARY KEY,
    cantidad_unidades INT NOT NULL,
    razon_cantidad_unidades TEXT,
    equipo_seguridad TEXT,
    otras_recomendaciones TEXT,
    id_solicitud INT NOT NULL UNIQUE,

    CONSTRAINT fk_recomendacion_solicitud
        FOREIGN KEY (id_solicitud)
        REFERENCES tb_solicitud(id_solicitud)
);

-- 6. TABLA PROGRAMACION
CREATE TABLE IF NOT EXISTS tb_programacion (
    id_programacion INT AUTO_INCREMENT PRIMARY KEY,
    fecha_registro DATETIME(6) NOT NULL,
    fecha_ejecucion DATETIME(6),
    fecha_finalizacion DATETIME(6),
    id_solicitud INT NOT NULL,
    id_coordinador INT NOT NULL,
    id_jefe_unidad INT NOT NULL,
    estado VARCHAR(255) NOT NULL,

    CONSTRAINT fk_programacion_solicitud
        FOREIGN KEY (id_solicitud)
        REFERENCES tb_solicitud(id_solicitud),

    CONSTRAINT fk_programacion_coordinador
        FOREIGN KEY (id_coordinador)
        REFERENCES tb_usuario(id_usuario),

    CONSTRAINT fk_programacion_jefe_unidad
        FOREIGN KEY (id_jefe_unidad)
        REFERENCES tb_usuario(id_usuario)
);

USE ecotrack2026_db;

SET time_zone = '-05:00';

-- 7. TABLA PAGO TOTAL
CREATE TABLE IF NOT EXISTS tb_pago_total (
    id_pago_total INT AUTO_INCREMENT PRIMARY KEY,
    monto DECIMAL(12,2) NOT NULL,
    fecha_operacion DATE NOT NULL,
    hora_operacion TIME NOT NULL,
    numero_operacion VARCHAR(255) NOT NULL,
    estado VARCHAR(255) NOT NULL,
    id_medio_pago INT NOT NULL,
    id_solicitud INT NOT NULL,

    CONSTRAINT fk_pago_total_medio_pago
        FOREIGN KEY (id_medio_pago)
        REFERENCES tb_medio_pago(id_medio_pago),

    CONSTRAINT fk_pago_total_solicitud
        FOREIGN KEY (id_solicitud)
        REFERENCES tb_solicitud(id_solicitud)
);

-- 8. TABLA PAGO INICIAL
CREATE TABLE IF NOT EXISTS tb_pago_inicial (
    id_pago_inicial INT AUTO_INCREMENT PRIMARY KEY,
    monto DECIMAL(12,2) NOT NULL,
    fecha_operacion DATE NOT NULL,
    hora_operacion TIME NOT NULL,
    numero_operacion VARCHAR(255) NOT NULL,
    estado VARCHAR(255) NOT NULL,
    id_medio_pago INT NOT NULL,
    id_solicitud INT NOT NULL,

    CONSTRAINT fk_pago_inicial_medio_pago
        FOREIGN KEY (id_medio_pago)
        REFERENCES tb_medio_pago(id_medio_pago),

    CONSTRAINT fk_pago_inicial_solicitud
        FOREIGN KEY (id_solicitud)
        REFERENCES tb_solicitud(id_solicitud)
);

-- 9. TABLA NOTIFICACION
CREATE TABLE IF NOT EXISTS tb_notificacion (
    id_notificacion INT AUTO_INCREMENT PRIMARY KEY,
    descripcion TEXT NOT NULL,
    estado BOOLEAN NOT NULL,
    id_usuario INT NOT NULL,

    CONSTRAINT fk_notificacion_usuario
        FOREIGN KEY (id_usuario)
        REFERENCES tb_usuario(id_usuario)
);

USE ecotrack2026_db;

SET time_zone = '-05:00';

-- 10. TABLA DETALLE
CREATE TABLE IF NOT EXISTS tb_detalle (
    id_detalle INT AUTO_INCREMENT PRIMARY KEY,
    id_transportista INT NOT NULL,
    id_vehiculo INT NOT NULL,
    id_programacion INT NOT NULL,
    estado BOOLEAN NOT NULL DEFAULT TRUE,

    CONSTRAINT fk_detalle_transportista
        FOREIGN KEY (id_transportista)
        REFERENCES tb_usuario(id_usuario),

    CONSTRAINT fk_detalle_vehiculo
        FOREIGN KEY (id_vehiculo)
        REFERENCES tb_vehiculo(id_vehiculo),

    CONSTRAINT fk_detalle_programacion
        FOREIGN KEY (id_programacion)
        REFERENCES tb_programacion(id_programacion)
);

-- 11. TABLA COLA
CREATE TABLE IF NOT EXISTS tb_cola (
    id_cola INT AUTO_INCREMENT PRIMARY KEY,
    fecha_registro DATETIME(6) NOT NULL,
    estado BOOLEAN NOT NULL DEFAULT TRUE,
    id_detalle INT NOT NULL,

    CONSTRAINT fk_cola_detalle
        FOREIGN KEY (id_detalle)
        REFERENCES tb_detalle(id_detalle)
);

-- 12. TABLA CARGA
CREATE TABLE IF NOT EXISTS tb_carga (
    id_carga INT AUTO_INCREMENT PRIMARY KEY,
    fecha_registro DATETIME(6) NOT NULL,
    peso_libras DECIMAL(10,2) NOT NULL,
    id_programacion INT NOT NULL,
    id_operario INT NOT NULL,
    id_transportista INT NOT NULL,
    id_cola INT NOT NULL UNIQUE,
    estado VARCHAR(255) NOT NULL DEFAULT 'EN_PROCESO',

    CONSTRAINT fk_carga_programacion
        FOREIGN KEY (id_programacion)
        REFERENCES tb_programacion(id_programacion),

    CONSTRAINT fk_carga_operario
        FOREIGN KEY (id_operario)
        REFERENCES tb_usuario(id_usuario),

    CONSTRAINT fk_carga_transportista
        FOREIGN KEY (id_transportista)
        REFERENCES tb_usuario(id_usuario),

    CONSTRAINT fk_carga_cola
        FOREIGN KEY (id_cola)
        REFERENCES tb_cola(id_cola)
);

USE ecotrack2026_db;

SET time_zone = '-05:00';

-- 13. TABLA RESERVA UNIDAD
CREATE TABLE IF NOT EXISTS tb_reserva_unidad (
    id_reserva INT AUTO_INCREMENT PRIMARY KEY,
    fecha_reserva DATETIME(6) NOT NULL,
    fecha_expiracion DATETIME(6) NOT NULL,
    id_programacion INT NOT NULL,
    id_transportista INT NOT NULL,
    id_vehiculo INT NOT NULL,
    id_usuario_reserva INT NOT NULL,

    CONSTRAINT uq_reserva_vehiculo UNIQUE (id_vehiculo),
    CONSTRAINT uq_reserva_transportista UNIQUE (id_transportista),

    CONSTRAINT fk_reserva_programacion
        FOREIGN KEY (id_programacion)
        REFERENCES tb_programacion(id_programacion),

    CONSTRAINT fk_reserva_transportista
        FOREIGN KEY (id_transportista)
        REFERENCES tb_usuario(id_usuario),

    CONSTRAINT fk_reserva_vehiculo
        FOREIGN KEY (id_vehiculo)
        REFERENCES tb_vehiculo(id_vehiculo),

    CONSTRAINT fk_reserva_usuario
        FOREIGN KEY (id_usuario_reserva)
        REFERENCES tb_usuario(id_usuario)
);

-- 14. TABLA ASIGNACION TOTAL
CREATE TABLE IF NOT EXISTS tb_asignacion_total (
    id_asignacion_total INT AUTO_INCREMENT PRIMARY KEY,
    monto_asignado_total DECIMAL(19,2) NOT NULL,
    razon VARCHAR(255) NOT NULL,
    monto_descontado DECIMAL(19,2) NOT NULL,
    monto_por_cobrar DECIMAL(19,2) NOT NULL,
    fecha_registro DATETIME(6) NOT NULL,
    id_solicitud INT NOT NULL UNIQUE,
    id_coordinador INT NOT NULL,

    CONSTRAINT fk_asignacion_total_solicitud
        FOREIGN KEY (id_solicitud)
        REFERENCES tb_solicitud(id_solicitud),

    CONSTRAINT fk_asignacion_total_coordinador
        FOREIGN KEY (id_coordinador)
        REFERENCES tb_usuario(id_usuario)
);

-- 15. TABLA ASIGNACION INICIAL
CREATE TABLE IF NOT EXISTS tb_asignacion_inicial (
    id_asignacion_inicial INT AUTO_INCREMENT PRIMARY KEY,
    monto_asignado_inicial DECIMAL(12,2) NOT NULL,
    razon VARCHAR(255) NOT NULL,
    fecha_registro DATETIME(6) NOT NULL,
    id_solicitud INT NOT NULL UNIQUE,
    id_coordinador INT NOT NULL,

    CONSTRAINT fk_asignacion_inicial_solicitud
        FOREIGN KEY (id_solicitud)
        REFERENCES tb_solicitud(id_solicitud),

    CONSTRAINT fk_asignacion_inicial_coordinador
        FOREIGN KEY (id_coordinador)
        REFERENCES tb_usuario(id_usuario)
);

USE ecotrack2026_db;

SET time_zone = '-05:00';

-- 16. TABLA ASIGNACION COORDINADOR
CREATE TABLE IF NOT EXISTS tb_asignacion_coordinador (
    id_asignacion_coordinador INT AUTO_INCREMENT PRIMARY KEY,
    id_solicitud INT NOT NULL UNIQUE,
    id_coordinador INT NOT NULL UNIQUE,

    CONSTRAINT fk_asignacion_coordinador_solicitud
        FOREIGN KEY (id_solicitud)
        REFERENCES tb_solicitud(id_solicitud),

    CONSTRAINT fk_asignacion_coordinador_usuario
        FOREIGN KEY (id_coordinador)
        REFERENCES tb_usuario(id_usuario)
);

-- 17. TABLA ARTICULO RECUPERADO
CREATE TABLE IF NOT EXISTS tb_articulo_recuperado (
    id_articulo_recuperado INT AUTO_INCREMENT PRIMARY KEY,
    articulo VARCHAR(255) NOT NULL,
    cantidad INT NOT NULL,
    id_carga INT NOT NULL,

    CONSTRAINT fk_articulo_recuperado_carga
        FOREIGN KEY (id_carga)
        REFERENCES tb_carga(id_carga)
);





