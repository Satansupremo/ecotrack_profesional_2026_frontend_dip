CREATE DATABASE IF NOT EXISTS ecotrack2026_db
CHARACTER SET utf8mb4
COLLATE utf8mb4_unicode_ci;

USE ecotrack2026_db;

SET time_zone = '-05:00';

CREATE TABLE tb_usuario (
    id_usuario INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(255) NOT NULL,
    apellido VARCHAR(255) NOT NULL,
    correo VARCHAR(255) NOT NULL UNIQUE,
    celular VARCHAR(255),
    username VARCHAR(255) NOT NULL UNIQUE,
    password VARCHAR(255) NOT NULL,
    dni VARCHAR(255) NOT NULL UNIQUE,
    estado BOOLEAN NOT NULL,
    rol VARCHAR(255) NOT NULL,
    situacion VARCHAR(255) NOT NULL
) ENGINE=InnoDB
DEFAULT CHARSET=utf8mb4
COLLATE=utf8mb4_unicode_ci;

CREATE TABLE tb_vehiculo (
    id_vehiculo INT AUTO_INCREMENT PRIMARY KEY,
    fecha_registro DATETIME(6) NOT NULL,
    placa VARCHAR(255) NOT NULL UNIQUE,
    marca VARCHAR(255) NOT NULL,
    modelo VARCHAR(255) NOT NULL,
    capacidad_libras DECIMAL(10,2) NOT NULL,
    tipo VARCHAR(255) NOT NULL,
    estado BOOLEAN NOT NULL,
    situacion VARCHAR(255) NOT NULL
) ENGINE=InnoDB
DEFAULT CHARSET=utf8mb4
COLLATE=utf8mb4_unicode_ci;

CREATE TABLE tb_medio_pago (
    id_medio_pago INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(255) NOT NULL,
    descripcion VARCHAR(255),
    numero_cuenta VARCHAR(255),
    estado BOOLEAN NOT NULL
) ENGINE=InnoDB
DEFAULT CHARSET=utf8mb4
COLLATE=utf8mb4_unicode_ci;

